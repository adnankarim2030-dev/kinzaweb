# Hostinger Apache Clean URLs & SEO-Friendly Routing
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Redirect /index.html to root /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s+/index\.html\s+HTTP/ [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    # 2. Redirect any browser request for *.html to clean URL (e.g. /about.html -> /about)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s+/([^.?\s]+)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # 3. Internally load the corresponding .html file for clean URLs
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^([^/]+)/?$ $1.html [L,QSA]
</IfModule>
